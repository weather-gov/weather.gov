# syntax=docker/dockerfile:1
#
# generic node docker image so we can run anything node-related
FROM node:24

RUN mkdir -p /app /app/api-interop-layer /app/api-proxy

WORKDIR /app

# hadolint ignore=DL3008
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  libgtk2.0-0 \
  libgtk-3-0 \
  libgbm-dev \
  libnotify-dev \
  libnss3 \
  libxss1 \
  libasound2 \
  libxtst6 \
  xauth \
  xvfb \
  && rm -rf /var/lib/apt/lists/*

COPY ./package.json .
COPY ./package-lock.json .
COPY ./api-interop-layer/package.json /app/api-interop-layer/
COPY ./api-interop-layer/package-lock.json /app/api-interop-layer/
COPY ./api-proxy/package.json /app/api-proxy/
COPY ./api-proxy/package-lock.json /app/api-proxy/

WORKDIR /app
RUN npm ci --dev
WORKDIR /app/api-interop-layer
RUN npm ci --dev
WORKDIR /app/api-proxy
RUN npm ci --dev
