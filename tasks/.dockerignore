# ignore all by default.
*

# allow only what is COPY'd in the Dockerfile{.prod,.wpcprob.prod}.
!go.mod
!go.sum
!crontab

# podman and docker treat `**` differently. so include the directories (and
# every file in them), drop every file, then allow the wanted extensions back.
!cmd/**/
!internal/**/
cmd/**/*.*
internal/**/*.*

# explicitly allow these extensions
!cmd/**/*.go
!internal/**/*.go

# exclude, not needed for images. directory excludes need the trailing `/**`.
**/*_test.go
**/test_data/**
