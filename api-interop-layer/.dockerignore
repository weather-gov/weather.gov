# ignore all by default.
*

# allow only what is COPY'd in the Dockerfile.{dev,prod}.
!package.json
!package-lock.json

!*.js
!newrelic.cjs

# podman and docker treat `**` differently. so include the directories (and
# every file in them), drop every file, then allow the wanted extensions back.
!data/**/
!routes/**/
!util/**/
data/**/*.*
routes/**/*.*
util/**/*.*

# explicitly allow these extensions
!data/**/*.js
!data/**/*.ohm
!data/**/*.txt
!routes/**/*.js
!util/**/*.js
!util/**/*.json

# exclude, not needed for images
**/*.test.js
